{
  "name": "vali-valid",
  "version": "3.1.0",
  "description": "ValiValid — framework-agnostic TypeScript validation engine. 74 built-in validators, fluent RuleBuilder, i18n (en/es/pt/fr/de). Use with vali-valid-react, vali-valid-vue, or vali-valid-svelte.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./core": {
      "types": "./dist/esm/core.d.mts",
      "import": "./dist/esm/core.mjs",
      "require": {
        "types": "./dist/cjs/core.d.ts",
        "default": "./dist/cjs/core.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "typescript",
    "validation",
    "form-validation",
    "validators",
    "schema",
    "field-validation",
    "rule-builder",
    "i18n",
    "async-validation",
    "framework-agnostic",
    "vali-valid"
  ],
  "author": "Felipe Rafael Montenegro Morriberon <teabajo_ubf@hotmail.com> (https://fm-portafolio.netlify.app/)",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/UBF21/Vali-Valid"
  },
  "homepage": "https://vali-valid-docs.netlify.app/",
  "bugs": {
    "url": "https://github.com/UBF21/Vali-Valid/issues"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
